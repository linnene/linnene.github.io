const allVisited = photoCards.flatMap((card) => card.cities);
---

<section class="photo-map-section" aria-label="摄影地图">
  <div class="map-shell" id="map-shell">
    <div class="map-main" id="map-main">
      <div id="china-map"></div>
    </div>
    <svg class="connector-svg" id="connector-svg" aria-hidden="true"></svg>

    <div class="photo-card-rail" aria-label="摄影地点">
      {photoCards.map((card) => (
        <button
          class="photo-card"
          id={`card-${card.id}`}
          type="button"
          aria-label={`${card.title} - ${card.caption}`}
          data-card-id={card.id}
          data-title={card.title}
          data-caption={card.caption}
          data-photos={JSON.stringify(card.photos)}
          data-cities={JSON.stringify(card.cities)}
        >
          <div class={`photo-stack ${card.photos.length > 1 ? 'is-stack' : ''}`}>
            {card.photos.slice(0, card.photos.length > 1 ? 3 : 1).map((photo, index) => (
              <div class="photo-layer" style={`--stack:${index}`}>
                <img class="photo-img" src={photo.src} alt={photo.label} loading="lazy" />
                <span class="photo-fallback" hidden>{photo.label}</span>
              </div>
            ))}
          </div>
          <div class="photo-info">
            <strong>{card.title}</strong>
            <span>{card.caption}</span>
          </div>
        </button>
      ))}
    </div>
  </div>

  <div class="gallery-modal" id="gallery-modal" aria-hidden="true">
    <div class="gallery-panel" role="dialog" aria-modal="true" aria-labelledby="gallery-title">
      <button class="gallery-close" id="gallery-close" type="button" aria-label="关闭">x</button>
      <div class="gallery-media">
        <img id="gallery-img" src="" alt="" />
        <div class="gallery-controls" aria-label="图集切换">
          <button id="gallery-prev" type="button">Prev</button>
          <span id="gallery-count"></span>
          <button id="gallery-next" type="button">Next</button>
        </div>
        <div class="gallery-thumbs" id="gallery-thumbs"></div>
      </div>
      <aside class="gallery-copy">
        <p class="gallery-kicker" id="gallery-place"></p>
        <h2 id="gallery-title"></h2>
        <p class="gallery-caption" id="gallery-caption"></p>
        <div class="gallery-note-block">
          <strong>感悟</strong>
          <p id="gallery-note"></p>
        </div>
        <div class="gallery-blog" id="gallery-blog"></div>
      </aside>
    </div>
  </div>
</section>

<span hidden data-all-cities={JSON.stringify(allVisited)}></span>

<script is:inline data-astro-rerun>
  (() => {
    const ECHARTS_CDN = 'https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js';
    const GEO_URLS = ['/maps/china.json', 'https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json'];
    const DRAG_DEAD = 3;

    const shell = document.getElementById('map-shell');
    const mapMain = document.getElementById('map-main');
    const mapNode = document.getElementById('china-map');
    const svg = document.getElementById('connector-svg');
    const cards = Array.from(shell.querySelectorAll('.photo-card'));
    const visitedCities = JSON.parse(document.querySelector('[data-all-cities]')?.dataset.allCities || '[]');

    const gallery = document.getElementById('gallery-modal');
    const galleryImg = document.getElementById('gallery-img');
    const galleryClose = document.getElementById('gallery-close');
    const galleryPrev = document.getElementById('gallery-prev');
    const galleryNext = document.getElementById('gallery-next');
    const galleryCount = document.getElementById('gallery-count');
    const galleryThumbs = document.getElementById('gallery-thumbs');
    const galleryPlace = document.getElementById('gallery-place');
    const galleryTitle = document.getElementById('gallery-title');
    const galleryCaption = document.getElementById('gallery-caption');
    const galleryNote = document.getElementById('gallery-note');
    const galleryBlog = document.getElementById('gallery-blog');

    let chart = null;
    let drag = null;
    let activeGallery = { photos: [], index: 0, title: '', caption: '' };

    function shellRect() {
      return shell.getBoundingClientRect();
    }

    function mapRect() {
      return mapMain.getBoundingClientRect();
    }

    function cardShellRect(card) {
      const rect = card.getBoundingClientRect();
      const base = shellRect();
      return {
        left: rect.left - base.left,
        top: rect.top - base.top,
        right: rect.right - base.left,
        bottom: rect.bottom - base.top,
      };
    }

    function loadScript(src) {
      if (window.echarts) return Promise.resolve();
      if (window.__echartsLoad) return window.__echartsLoad;
      window.__echartsLoad = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.onload = resolve;
        script.onerror = () => {
          window.__echartsLoad = null;
          reject(new Error(`Script load failed: ${src}`));
        };
        document.head.appendChild(script);
      });
      return window.__echartsLoad;
    }

    async function loadGeoJson() {
      let lastError;
      for (const url of GEO_URLS) {
        try {
          const response = await fetch(url, { cache: 'no-store' });
          if (!response.ok) throw new Error(`GeoJSON request failed: ${response.status}`);
          return await response.json();
        } catch (error) {
          lastError = error;
        }
      }
      throw lastError || new Error('GeoJSON request failed');
    }

    function initChart(echarts, geo) {
      const compact = window.matchMedia('(max-width: 860px)').matches;
      echarts.registerMap('china', geo);
      chart = echarts.init(mapNode);
      chart.setOption({
        backgroundColor: 'transparent',
        animationDuration: 600,
        geo: {
          map: 'china',
          roam: false,
          zoom: compact ? 1.08 : 1.28,
          center: compact ? [104.5, 33.2] : [105, 32.6],
          aspectScale: 0.85,
          itemStyle: { areaColor: '#eeeeee', borderColor: '#c8c8c8', borderWidth: 0.75 },
          emphasis: { itemStyle: { areaColor: '#e4e4e4' }, label: { show: false } },
        },
        series: [{
          type: 'effectScatter',
          coordinateSystem: 'geo',
          data: visitedCities.map((city) => ({
            name: city.name,
            value: city.coords,
            label: {
              position: city.labelPosition || 'right',
              distance: compact ? 5 : (city.labelDistance || 8),
              fontSize: compact ? 11 : (city.compactLabel ? 14 : 20),
            },
          })),
          symbol: 'circle',
          symbolSize: compact ? 6 : 8,
          rippleEffect: { brushType: 'stroke', scale: compact ? 2.5 : 3.5, period: 3.2, color: '#111111' },
          itemStyle: { color: '#111111', borderColor: '#ffffff', borderWidth: 2 },
          label: {
            show: true,
            position: 'right',
            color: '#1f2328',
            fontSize: compact ? 11 : 20,
            fontWeight: 900,
            fontFamily: 'Georgia, "Noto Serif SC", "Songti SC", serif',
            textBorderColor: '#ffffff',
            textBorderWidth: 3,
            formatter: '{b}',
          },
          labelLayout: { hideOverlap: true },
        }],
      });

      setTimeout(() => {
        positionCards();
        drawConnectors();
      }, 150);
      chart.on('finished', drawConnectors);
    }

    function syncChartForViewport() {
      if (!chart) return;
      const compact = window.matchMedia('(max-width: 860px)').matches;
      chart.setOption({
        geo: {
          zoom: compact ? 1.08 : 1.28,
          center: compact ? [104.5, 33.2] : [105, 32.6],
        },
        series: [{
          symbolSize: compact ? 6 : 8,
          rippleEffect: { scale: compact ? 2.5 : 3.5 },
          label: { fontSize: compact ? 11 : 20 },
          data: visitedCities.map((city) => ({
            name: city.name,
            value: city.coords,
            label: {
              position: city.labelPosition || 'right',
              distance: compact ? 5 : (city.labelDistance || 8),
              fontSize: compact ? 11 : (city.compactLabel ? 14 : 20),
            },
          })),
        }],
      });
    }

    function drawConnectors() {
      if (!chart) return;
      const shellBox = shellRect();
      const mapBox = mapRect();
      svg.setAttribute('viewBox', `0 0 ${shellBox.width} ${shellBox.height}`);
      svg.style.width = `${shellBox.width}px`;
      svg.style.height = `${shellBox.height}px`;

      let html = '';
      cards.forEach((card) => {
        const cities = JSON.parse(card.dataset.cities || '[]');
        if (!cities.length) return;

        let lng = 0;
        let lat = 0;
        cities.forEach((city) => {
          lng += city.coords[0];
          lat += city.coords[1];
        });

        const pixel = chart.convertToPixel({ geoIndex: 0 }, [lng / cities.length, lat / cities.length]);
        if (!pixel) return;

        const sx = pixel[0] + (mapBox.left - shellBox.left);
        const sy = pixel[1] + (mapBox.top - shellBox.top);
        const cardBox = cardShellRect(card);
        const edgePoints = [
          { x: (cardBox.left + cardBox.right) / 2, y: cardBox.top },
          { x: cardBox.right, y: (cardBox.top + cardBox.bottom) / 2 },
          { x: (cardBox.left + cardBox.right) / 2, y: cardBox.bottom },
          { x: cardBox.left, y: (cardBox.top + cardBox.bottom) / 2 },
        ];

        let target = edgePoints[0];
        let targetDistance = Infinity;
        edgePoints.forEach((point) => {
          const distance = Math.hypot(point.x - sx, point.y - sy);
          if (distance < targetDistance) {
            target = point;
            targetDistance = distance;
          }
        });

        const ex = target.x;
        const ey = target.y;
        const pull = Math.sign(ex - sx || 1) * Math.max(90, Math.abs(ex - sx));
        const c1x = sx + pull * 0.35;
        const c1y = sy - 18;
        const c2x = ex - pull * 0.18;
        const c2y = ey + 8;

        html += `<path d="M${sx} ${sy} C${c1x} ${c1y},${c2x} ${c2y},${ex} ${ey}" fill="none" stroke="#151515" stroke-width="1.8" stroke-linecap="round" vector-effect="non-scaling-stroke" />`;
        html += `<circle cx="${sx}" cy="${sy}" r="4" fill="#111" stroke="#fff" stroke-width="2.2" />`;
        html += `<circle cx="${ex}" cy="${ey}" r="3.4" fill="#111" stroke="#fff" stroke-width="2" />`;
      });

      svg.innerHTML = html;
    }

    function positionCards() {
      if (window.matchMedia('(max-width: 860px)').matches) return;
      const shellBox = shellRect();
      const mapBox = mapRect();
      const w = 246;
      const h = 204;
      const layout = {
        siguniang: { x: mapBox.left + w * 1.1, y: mapBox.top + h * 1.18 },
        chongqing: { x: mapBox.left + w * 2.6, y: mapBox.top + h * 0.34 },
        shanghai: { x: mapBox.right - w * 2.0, y: mapBox.top + h * 0.2 },
        xiamen: { x: mapBox.right - w * 1.85, y: mapBox.top + h * 1.8 },
        yunnan: { x: mapBox.left + w * 1.3, y: mapBox.bottom - h * 1.4 },
        guiyang: { x: mapBox.left + w * 2.6, y: mapBox.bottom - h * 0.85 },
        guangzhou: { x: mapBox.right - w * 2.2, y: mapBox.bottom - h * 0.92 },
      };

      cards.forEach((card) => {
        if (card.dataset.dragged === 'true') return;
        const pos = layout[card.dataset.cardId];
        if (!pos) return;
        card.style.left = `${Math.round(Math.max(4, Math.min(pos.x - shellBox.left, shellBox.width - w - 4)))}px`;
        card.style.top = `${Math.round(Math.max(4, Math.min(pos.y - shellBox.top, shellBox.height - h - 4)))}px`;
      });
    }

    function renderGallery() {
      const { photos, index, title, caption } = activeGallery;
      const photo = photos[index];
      if (!photo) return;

      galleryImg.src = photo.fullSrc || photo.src;
      galleryImg.alt = photo.label || title;
      galleryPlace.textContent = title;
      galleryTitle.textContent = photo.label || title;
      galleryCaption.textContent = caption;
      galleryNote.textContent = photo.note || '待整理。';
      galleryCount.textContent = `${index + 1} / ${photos.length}`;
      galleryPrev.disabled = photos.length <= 1;
      galleryNext.disabled = photos.length <= 1;
      galleryThumbs.hidden = photos.length <= 1;

      if (photo.blog?.href && photo.blog?.title) {
        galleryBlog.innerHTML = `<a href="${photo.blog.href}">挂钩的 Blog：${photo.blog.title}</a>`;
      } else {
        galleryBlog.textContent = '挂钩的 Blog：待整理';
      }

      galleryThumbs.innerHTML = photos.map((item, itemIndex) => `
        <button class="gallery-thumb ${itemIndex === index ? 'is-active' : ''}" type="button" data-index="${itemIndex}" aria-label="查看 ${item.label || `第 ${itemIndex + 1} 张`}">
          <img src="${item.src}" alt="" />
        </button>
      `).join('');
    }

    function openGallery(card) {
      const photos = JSON.parse(card.dataset.photos || '[]');
      if (!photos.length) return;
      activeGallery = {
        photos,
        index: 0,
        title: card.dataset.title || '',
        caption: card.dataset.caption || '',
      };
      renderGallery();
      gallery.classList.add('is-open');
      gallery.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('gallery-open');
    }

    function closeGallery() {
      gallery.classList.remove('is-open');
      gallery.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('gallery-open');
      galleryImg.src = '';
    }

    function stepGallery(direction) {
      const total = activeGallery.photos.length;
      if (total <= 1) return;
      activeGallery.index = (activeGallery.index + direction + total) % total;
      renderGallery();
    }

    function onDown(event) {
      const card = event.target.closest('.photo-card');
      if (!card || window.matchMedia('(max-width: 860px)').matches) return;
      event.preventDefault();
      card.setPointerCapture(event.pointerId);
      card.classList.add('is-dragging');
      const base = shellRect();
      const rect = card.getBoundingClientRect();
      drag = {
        card,
        sx: event.clientX,
        sy: event.clientY,
        ol: rect.left - base.left,
        ot: rect.top - base.top,
        moved: false,
      };
    }

    function onMove(event) {
      if (!drag) return;
      const dx = event.clientX - drag.sx;
      const dy = event.clientY - drag.sy;
      if (Math.abs(dx) + Math.abs(dy) > DRAG_DEAD) drag.moved = true;
      if (!drag.moved) return;
      drag.card.style.left = `${Math.round(drag.ol + dx)}px`;
      drag.card.style.top = `${Math.round(drag.ot + dy)}px`;
      drag.card.dataset.dragged = 'true';
      requestAnimationFrame(drawConnectors);
    }

    function onUp() {
      if (!drag) return;
      const card = drag.card;
      const moved = drag.moved;
      card.classList.remove('is-dragging');
      drag = null;
      if (!moved) openGallery(card);
      requestAnimationFrame(drawConnectors);
    }

    cards.forEach((card) => {
      card.addEventListener('click', (event) => {
        if (!window.matchMedia('(max-width: 860px)').matches) return;
        event.preventDefault();
        openGallery(card);
      });

      card.querySelectorAll('.photo-img').forEach((img) => {
        img.addEventListener('load', () => {
          positionCards();
          requestAnimationFrame(drawConnectors);
        });
        img.addEventListener('error', () => {
          img.hidden = true;
          img.nextElementSibling.hidden = false;
          positionCards();
          requestAnimationFrame(drawConnectors);
        });
      });
    });

    galleryClose.addEventListener('click', closeGallery);
    galleryPrev.addEventListener('click', () => stepGallery(-1));
    galleryNext.addEventListener('click', () => stepGallery(1));
    galleryThumbs.addEventListener('click', (event) => {
      const thumb = event.target.closest('.gallery-thumb');
      if (!thumb) return;
      activeGallery.index = Number.parseInt(thumb.dataset.index || '0', 10);
      renderGallery();
    });
    gallery.addEventListener('click', (event) => {
      if (event.target === gallery) closeGallery();
    });
    document.addEventListener('keydown', (event) => {
      if (!gallery.classList.contains('is-open')) return;
      if (event.key === 'Escape') closeGallery();
      if (event.key === 'ArrowLeft') stepGallery(-1);
      if (event.key === 'ArrowRight') stepGallery(1);
    });

    shell.addEventListener('pointerdown', onDown);
    document.addEventListener('pointermove', onMove);
    document.addEventListener('pointerup', onUp);

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (chart) chart.resize();
        syncChartForViewport();
        positionCards();
        setTimeout(drawConnectors, 100);
      }, 150);
    });

    document.addEventListener('astro:page-load', () => {
      setTimeout(() => {
        if (chart) chart.resize();
        positionCards();
        setTimeout(drawConnectors, 100);
      }, 200);
    });

    async function boot() {
      try {
        await loadScript(ECHARTS_CDN);
        const geo = await loadGeoJson();
        initChart(window.echarts, geo);
      } catch (error) {
        console.error('Photography map failed:', error);
        mapNode.classList.add('map-failed');
        mapNode.textContent = '地图加载失败';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>

<style>
  :global(.gallery-open) {
    overflow: hidden;
  }

  .photo-map-section {
    padding: 0;
    height: min(920px, calc(100vh + 4rem));
    min-height: 760px;
    margin-top: 0.8rem;
    margin-bottom: 2.5rem;
  }

  .map-shell {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .map-main {
    position: absolute;
    inset: 0.8rem clamp(120px, 9vw, 170px) 4.8rem clamp(70px, 5.5vw, 120px);
  }

  #china-map {
    width: 100%;
    height: 100%;
  }

  .map-failed {
    display: grid;
    place-items: center;
    color: var(--muted);
    border: 1px solid var(--soft-line);
  }

  .connector-svg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  .photo-card-rail {
    display: contents;
  }

  .photo-card {
    position: absolute;
    z-index: 10;
    width: clamp(219px, 16.2vw, 282px);
    background: #ffffff;
    border: 1px solid #202020;
    padding: 0.72rem 0.72rem 0.6rem;
    box-shadow: 0.42rem 0.42rem 0 #d8d8d8, inset 0 0 0 1px rgba(0, 0, 0, 0.035);
    cursor: grab;
    text-align: left;
    user-select: none;
    transform: rotate(1.2deg);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  #card-siguniang { transform: rotate(-1.4deg); }
  #card-chongqing { transform: rotate(1.1deg); }
  #card-shanghai { transform: rotate(1.3deg); }
  #card-xiamen { transform: rotate(-0.9deg); }
  #card-yunnan { transform: rotate(1.8deg); }
  #card-guiyang { transform: rotate(-1.2deg); }
  #card-guangzhou { transform: rotate(1.4deg); }

