---
const photoCards = [
  { id: 'xiamen',    title: '厦门',     caption: '鼓浪屿 / 2025', cities: [{ name: '厦门',     coords: [118.08, 24.48] }], photos: [{ src: '/images/photography/xiamen/cover.jpg',            label: '厦门'     }] },
  { id: 'siguniang', title: '四姑娘山', caption: '川西 / 待整理', cities: [{ name: '四姑娘山', coords: [102.90, 31.10] }], photos: [{ src: '/images/photography/siguniang-mountain/cover.jpg', label: '四姑娘山' }] },
  { id: 'chongqing', title: '重庆',     caption: '山城 / 待整理', cities: [{ name: '重庆',     coords: [106.55, 29.56] }], photos: [{ src: '/images/photography/chongqing/cover.jpg',        label: '重庆'     }] },
  { id: 'shanghai',  title: '上海',     caption: '城市 / 待整理', cities: [{ name: '上海',     coords: [121.47, 31.23] }], photos: [{ src: '/images/photography/shanghai/cover.jpg',          label: '上海'     }] },
  { id: 'guangzhou', title: '广州',     caption: '岭南 / 待整理', cities: [{ name: '广州',     coords: [113.26, 23.13] }], photos: [{ src: '/images/photography/guangzhou/cover.jpg',         label: '广州'     }] },
  { id: 'guiyang',   title: '贵阳',     caption: '黔中 / 待整理', cities: [{ name: '贵阳',     coords: [106.63, 26.65] }], photos: [{ src: '/images/photography/guiyang/cover.jpg',           label: '贵阳'     }] },
  {
    id: 'yunnan', title: '云南', caption: '滇西北 / 待整理',
    cities: [
      { name: '丽江', coords: [100.23, 26.86] }, { name: '大理', coords: [100.27, 25.61] },
      { name: '香格里拉', coords: [99.71, 27.83] }, { name: '昆明', coords: [102.83, 24.88] }, { name: '德钦', coords: [98.91, 28.49] },
    ],
    photos: [
      { src: '/images/photography/yunnan/lijiang-cover.jpg', label: '丽江' }, { src: '/images/photography/yunnan/dali-cover.jpg', label: '大理' },
      { src: '/images/photography/yunnan/shangri-la-cover.jpg', label: '香格里拉' }, { src: '/images/photography/yunnan/kunming-cover.jpg', label: '昆明' },
      { src: '/images/photography/yunnan/deqin-cover.jpg', label: '德钦' },
    ],
  },
];
const allVisited = photoCards.flatMap(c => c.cities);
const firstCard  = photoCards[0];
const firstPhoto = firstCard.photos[0];
---

<section class="photo-map-section" aria-label="摄影地图">
  <div class="map-shell" id="map-shell">
    <div class="map-main" id="map-main">
      <div id="china-map"></div>
    </div>
    <svg class="connector-svg" id="connector-svg" aria-hidden="true"></svg>

    {photoCards.map((card) => (
      <button
        class="photo-card"
        id={`card-${card.id}`}
        type="button"
        aria-label={`${card.title} — ${card.caption}`}
        data-card-id={card.id}
        data-caption={card.caption}
        data-photos={JSON.stringify(card.photos)}
        data-cities={JSON.stringify(card.cities)}
      >
        <div class={`photo-stack ${card.photos.length > 1 ? 'is-stack' : ''}`}>
          {card.photos.slice(0, card.photos.length > 1 ? 3 : 1).map((p, i) => (
            <div class="photo-layer" style={`--stack:${i}`}>
              <img class="photo-img" src={p.src} alt={p.label} loading="lazy" />
              <span class="photo-fallback" hidden>{p.label}</span>
            </div>
          ))}
        </div>
        <div class="photo-info">
          <strong>{card.title}</strong>
          <span>{card.caption}</span>
        </div>
      </button>
    ))}
  </div>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="关闭">×</button>
    <img id="lightbox-img" src="" alt="" />
    <p id="lightbox-caption"></p>
  </div>
</section>

<span hidden data-all-cities={JSON.stringify(allVisited)}></span>

<script>
  (function () {
    const ECHARTS_CDN = 'https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js';
    const GEO_CDN     = 'https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json';
    const DRAG_DEAD   = 3;

    const section   = document.querySelector('.photo-map-section');
    const shell     = document.getElementById('map-shell');
    const mapMain   = document.getElementById('map-main');
    const mapNode   = document.getElementById('china-map');
    const svg       = document.getElementById('connector-svg');
    const cards     = Array.from(shell.querySelectorAll('.photo-card'));

    const lightbox      = document.getElementById('lightbox');
    const lightboxImg   = document.getElementById('lightbox-img');
    const lightboxCap   = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');

    let chart = null;
    let drag  = null; // { card, sx, sy, ol, ot, moved }

    /* ── utils ── */
    function sr() { return shell.getBoundingClientRect(); }
    function mr() { return mapMain.getBoundingClientRect(); }

    /* nearest point on rect boundary */
    function nearestEdge(px, py, rect) {
      const cx = Math.max(rect.left, Math.min(px, rect.right));
      const cy = Math.max(rect.top,  Math.min(py, rect.bottom));
      return { x: cx, y: cy };
    }

    /* card rect in shell coords */
    function cardShellRect(card) {
      const r = card.getBoundingClientRect();
      const s = sr();
      return { left: r.left - s.left, top: r.top - s.top, right: r.right - s.left, bottom: r.bottom - s.top };
    }

    /* ── ECharts ── */
    function loadScript(src) {
      if (window.echarts) return Promise.resolve();
      if (window.__echLoad) return window.__echLoad;
      window.__echLoad = new Promise((resolve, reject) => {
        const s = document.createElement('script'); s.src = src;
        s.onload = resolve; s.onerror = () => { window.__echLoad = null; reject(); };
        document.head.appendChild(s);
      });
      return window.__echLoad;
    }

    function initChart(echarts, geo) {
      echarts.registerMap('china', geo);
      chart = echarts.init(mapNode);
      chart.setOption({
        backgroundColor: 'transparent', animationDuration: 700,
        geo: {
          map: 'china', roam: false, zoom: 1.18, center: [105, 34], aspectScale: 0.85,
          itemStyle: { areaColor: '#eeeeee', borderColor: '#c8c8c8', borderWidth: 0.6 },
          emphasis: { itemStyle: { areaColor: '#e4e4e4' }, label: { show: false } },
        },
        series: [{
          type: 'effectScatter', coordinateSystem: 'geo',
          data: allVisited.map(c => ({
            name: c.name, value: c.coords,
            label: { position: c.labelPosition || 'right', distance: c.labelDistance || 8, fontSize: c.compactLabel ? 13 : 18 },
          })),
          symbol: 'circle', symbolSize: 8,
          rippleEffect: { brushType: 'stroke', scale: 3.5, period: 3.2, color: '#111111' },
          itemStyle: { color: '#111111', borderColor: '#ffffff', borderWidth: 2 },
          label: { show: true, position: 'right', distance: 8, color: '#30343a', fontSize: 18, fontWeight: 900, fontFamily: 'Georgia, serif', formatter: '{b}' },
          labelLayout: { hideOverlap: true },
        }],
      });
      setTimeout(() => { positionCards(); drawConnectors(); }, 150);
      chart.on('finished', () => { drawConnectors(); });
    }

    /* ── connectors ── */
    function drawConnectors() {
      if (!chart) return;
      const S = sr(), M = mr();
      svg.setAttribute('viewBox', `0 0 ${S.width} ${S.height}`);
      svg.style.width  = S.width + 'px';
      svg.style.height = S.height + 'px';

      let html = '';
      cards.forEach(card => {
        const cities = JSON.parse(card.dataset.cities || '[]');
        if (!cities.length) return;
        const cRect = cardShellRect(card);

        // centroid of cities in shell coords
        let cx = 0, cy = 0;
        cities.forEach(c => { cx += c.coords[0]; cy += c.coords[1]; });
        const pixel = chart.convertToPixel({ geoIndex: 0 }, [cx / cities.length, cy / cities.length]);
        if (!pixel) return;
        const sx = pixel[0] + (M.left - S.left);
        const sy = pixel[1] + (M.top  - S.top);

        // nearest edge midpoint
        const midpoints = [
          { x: (cRect.left + cRect.right) / 2, y: cRect.top },      // top
          { x: cRect.right,                     y: (cRect.top + cRect.bottom) / 2 }, // right
          { x: (cRect.left + cRect.right) / 2, y: cRect.bottom },   // bottom
          { x: cRect.left,                      y: (cRect.top + cRect.bottom) / 2 }, // left
        ];
        let best = midpoints[0], bestD = Infinity;
        midpoints.forEach(m => { const d = Math.hypot(m.x - sx, m.y - sy); if (d < bestD) { bestD = d; best = m; } });
        const ex = best.x, ey = best.y;

        // bezier
        const dx = ex - sx, pull = Math.sign(dx || 1) * Math.max(80, Math.abs(dx));
        const c1x = sx + pull * 0.35, c1y = sy - 24;
        const c2x = ex - pull * 0.2,  c2y = ey + 10;

        html += `<path d="M${sx} ${sy} C${c1x} ${c1y},${c2x} ${c2y},${ex} ${ey}" fill="none" stroke="#222" stroke-width="1.2" />`;
        html += `<circle cx="${sx}" cy="${sy}" r="3.5" fill="#111" stroke="#fff" stroke-width="2" />`;
        html += `<circle cx="${ex}" cy="${ey}" r="3"   fill="#111" stroke="#fff" stroke-width="2" />`;
      });
      svg.innerHTML = html;
    }

    /* ── position cards ── */
    function positionCards() {
      if (window.matchMedia('(max-width: 860px)').matches) return;
      const S = sr(), M = mr();
      const w = 162; // approximate card width
      const h = 140; // approximate card height
      const layout = {
        xiamen:    { x: M.right  - w * 0.4, y: M.top    + h * 0.0 },
        siguniang: { x: M.left   - w * 1.0, y: M.top    + h * 0.1 },
        chongqing: { x: M.left   - w * 1.0, y: M.top    + h * 1.5 },
        shanghai:  { x: M.right  - w * 0.4, y: M.top    + h * 1.8 },
        guangzhou: { x: M.right  - w * 1.6, y: M.bottom + h * 0.15 },
        guiyang:   { x: M.left   - w * 0.8, y: M.bottom - h * 0.1 },
        yunnan:    { x: M.left   - w * 0.8, y: M.bottom + h * 0.8 },
      };

      cards.forEach(card => {
        if (card.dataset.dragged === 'true') return;
        const pos = layout[card.dataset.cardId];
        if (!pos) return;
        // clamp to shell
        const left = Math.round(Math.max(4, Math.min(pos.x - S.left, S.width - w - 4)));
        const top  = Math.round(Math.max(4, Math.min(pos.y - S.top,  S.height - h - 4)));
        card.style.left = left + 'px';
        card.style.top  = top  + 'px';
      });
    }

    /* ── drag ── */
    function onDown(e) {
      const card = e.target.closest('.photo-card');
      if (!card || window.matchMedia('(max-width: 860px)').matches) return;
      e.preventDefault();
      card.setPointerCapture(e.pointerId);
      card.classList.add('is-dragging');
      const S = sr();
      const r = card.getBoundingClientRect();
      drag = {
        card,
        sx: e.clientX, sy: e.clientY,
        ol: r.left - S.left, ot: r.top - S.top,
        moved: false,
      };
    }

    function onMove(e) {
      if (!drag) return;
      const dx = e.clientX - drag.sx, dy = e.clientY - drag.sy;
      if (Math.abs(dx) + Math.abs(dy) > DRAG_DEAD) drag.moved = true;
      if (!drag.moved) return;

      drag.card.style.left = Math.round(drag.ol + dx) + 'px';
      drag.card.style.top  = Math.round(drag.ot + dy) + 'px';
      drag.card.dataset.dragged = 'true';
      requestAnimationFrame(drawConnectors);
    }

    function onUp(e) {
      if (!drag) return;
      drag.card.classList.remove('is-dragging');
      const moved = drag.moved;
      drag = null;
      if (!moved) {
        // click → lightbox
        const card = e.target.closest('.photo-card');
        if (!card) return;
        const photos  = JSON.parse(card.dataset.photos || '[]');
        const caption = card.dataset.caption || '';
        if (photos.length) {
          lightboxImg.src = photos[0].src;
          lightboxImg.alt = photos[0].label;
          lightboxCap.textContent = (card.querySelector('strong')?.textContent || '') + ' · ' + caption;
          lightbox.classList.add('is-open');
          lightbox.setAttribute('aria-hidden', 'false');
        }
      }
      requestAnimationFrame(drawConnectors);
    }

    /* ── lightbox ── */
    lightboxClose.addEventListener('click', () => { lightbox.classList.remove('is-open'); lightbox.setAttribute('aria-hidden', 'true'); });
    lightbox.addEventListener('click', e => { if (e.target === lightbox) { lightbox.classList.remove('is-open'); lightbox.setAttribute('aria-hidden', 'true'); } });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') { lightbox.classList.remove('is-open'); lightbox.setAttribute('aria-hidden', 'true'); } });

    /* ── image fallback ── */
    cards.forEach(card => {
      card.querySelectorAll('.photo-img').forEach(img => {
        img.addEventListener('error', () => { img.hidden = true; img.nextElementSibling.hidden = false; });
      });
    });

    /* ── events ── */
    shell.addEventListener('pointerdown', onDown);
    document.addEventListener('pointermove', onMove);
    document.addEventListener('pointerup', onUp);

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (chart) chart.resize();
        positionCards();
        setTimeout(drawConnectors, 100);
      }, 150);
    });

    document.addEventListener('astro:page-load', () => {
      setTimeout(() => {
        if (chart) chart.resize();
        positionCards();
        setTimeout(drawConnectors, 100);
      }, 200);
    });

    /* ── boot ── */
    async function boot() {
      try {
        await loadScript(ECHARTS_CDN);
        const res = await fetch(GEO_CDN);
        const geo = await res.json();
        initChart(window.echarts, geo);
      } catch {
        mapNode.classList.add('map-failed');
        mapNode.textContent = '地图加载失败';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>

<style>
  .photo-map-section {
    padding: 0;
    height: calc(100vh - 8rem);
    min-height: 560px;
  }

  .map-shell {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .map-main {
    position: absolute;
    inset: 1rem clamp(200px, 18vw, 280px) 1rem clamp(140px, 12vw, 200px);
  }

  #china-map {
    width: 100%;
    height: 100%;
  }

  .map-failed {
    display: grid; place-items: center; color: var(--muted); border: 1px solid var(--soft-line);
  }

  /* svg connector */
  .connector-svg {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 5;
  }

  /* ── cards ── */
  .photo-card {
    position: absolute; z-index: 10;
    width: 162px;
    background: var(--panel); border: 1px solid #202020;
    padding: 0.55rem 0.55rem 0.45rem;
    box-shadow: 0.4rem 0.4rem 0 #d8d8d8;
    cursor: grab; text-align: left; user-select: none;
    transform: rotate(1.2deg);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .photo-card:hover {
    transform: rotate(0.5deg) translateY(-2px);
    box-shadow: 0.5rem 0.5rem 0 #cfcfcf;
  }
  .photo-card.is-dragging {
    z-index: 20; cursor: grabbing;
    transform: rotate(0deg) scale(1.02);
    box-shadow: 0.65rem 0.65rem 0 #c7c7c7;
    transition: box-shadow 120ms ease;
  }

  .photo-card img { -webkit-user-drag: none; }

  /* stack */
  .photo-stack { display: block; }
  .photo-stack.is-stack { position: relative; }
  .photo-layer {
    display: block; aspect-ratio: 4/3;
    background: #f5f5f5; overflow: hidden;
  }
  .is-stack .photo-layer {
    position: absolute; inset: 0;
    transition: transform 180ms ease;
  }
  .is-stack .photo-layer:nth-child(1) { position: relative; }
  .is-stack:hover .photo-layer:nth-child(2) { transform: translate(6px, -6px); }
  .is-stack:hover .photo-layer:nth-child(3) { transform: translate(12px, -12px); }

  .photo-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(100%); }
  .photo-fallback {
    display: grid; place-items: center;
    width: 100%; height: 100%;
    color: #bbb; font-size: 0.75rem; font-weight: 700;
    font-family: "JetBrains Mono", monospace; letter-spacing: 0.1em;
  }
  .photo-info {
    display: flex; justify-content: space-between; gap: 0.6rem;
    margin-top: 0.45rem; font-size: 0.8rem; line-height: 1.25;
  }
  .photo-info strong { font-size: 0.88rem; font-weight: 800; color: var(--ink); }
  .photo-info span { color: var(--muted); text-align: right; }

  /* lightbox */
  .lightbox {
    position: fixed; inset: 0; z-index: 50;
    display: none; place-items: center;
    background: rgba(255,255,255,0.92); padding: 2rem;
  }
  .lightbox.is-open { display: grid; }
  .lightbox img {
    max-width: min(92vw, 1200px); max-height: 82vh; object-fit: contain;
    border: 1px solid #202020; background: #fff;
    box-shadow: 0.55rem 0.55rem 0 #d8d8d8;
  }
  .lightbox p { margin: 1rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .lightbox-close {
    position: absolute; top: 1.2rem; right: 1.5rem;
    color: var(--ink); font-size: 2rem; line-height: 1; cursor: pointer;
    background: none; border: none;
  }

  @media (max-width: 860px) {
    .photo-map-section { height: auto; min-height: auto; padding: 1rem; }
    .map-shell { overflow: visible; display: flex; flex-direction: column; gap: 1rem; height: auto; }
    .map-main { position: relative; inset: auto; height: 50vh; min-height: 360px; }
    .connector-svg { display: none; }
    .photo-card { position: static !important; left: auto !important; top: auto !important; width: 100%; max-width: 260px; transform: rotate(0.5deg); }
  }
</style>
