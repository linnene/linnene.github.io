---
const photoCards = [
  {
    id: 'xiamen',
    title: '厦门',
    caption: '鼓浪屿 / 2025',
    placement: 'right-top',
    cities: [{ name: '厦门', coords: [118.08, 24.48] }],
    photos: [{ src: '/images/photography/xiamen/cover.jpg', label: '厦门' }],
  },
  {
    id: 'siguniang-mountain',
    title: '四姑娘山',
    caption: '川西 / 待整理',
    placement: 'left-top',
    cities: [{ name: '四姑娘山', coords: [102.9, 31.1] }],
    photos: [{ src: '/images/photography/siguniang-mountain/cover.jpg', label: '四姑娘山' }],
  },
  {
    id: 'chongqing',
    title: '重庆',
    caption: '山城 / 待整理',
    placement: 'left-mid',
    cities: [{ name: '重庆', coords: [106.55, 29.56] }],
    photos: [{ src: '/images/photography/chongqing/cover.jpg', label: '重庆' }],
  },
  {
    id: 'shanghai',
    title: '上海',
    caption: '城市 / 待整理',
    placement: 'right-mid',
    cities: [{ name: '上海', coords: [121.47, 31.23] }],
    photos: [{ src: '/images/photography/shanghai/cover.jpg', label: '上海' }],
  },
  {
    id: 'guangzhou',
    title: '广州',
    caption: '岭南 / 待整理',
    placement: 'bottom-mid',
    cities: [{ name: '广州', coords: [113.26, 23.13] }],
    photos: [{ src: '/images/photography/guangzhou/cover.jpg', label: '广州' }],
  },
  {
    id: 'guiyang',
    title: '贵阳',
    caption: '黔中 / 待整理',
    placement: 'left-bottom',
    cities: [{ name: '贵阳', coords: [106.63, 26.65] }],
    photos: [{ src: '/images/photography/guiyang/cover.jpg', label: '贵阳' }],
  },
  {
    id: 'yunnan',
    title: '云南',
    caption: '滇西北 / 待整理',
    placement: 'bottom-left',
    cities: [
      { name: '丽江', coords: [100.23, 26.86], labelPosition: 'right', labelDistance: 12, compactLabel: true },
      { name: '大理', coords: [100.27, 25.61], labelPosition: 'bottom', labelDistance: 10, compactLabel: true },
      { name: '香格里拉', coords: [99.71, 27.83], labelPosition: 'top', labelDistance: 12, compactLabel: true },
      { name: '昆明', coords: [102.83, 24.88], labelPosition: 'right', labelDistance: 14, compactLabel: true },
      { name: '德钦', coords: [98.91, 28.49], labelPosition: 'left', labelDistance: 12, compactLabel: true },
    ],
    photos: [
      { src: '/images/photography/yunnan/lijiang-cover.jpg', label: '丽江' },
      { src: '/images/photography/yunnan/dali-cover.jpg', label: '大理' },
      { src: '/images/photography/yunnan/shangri-la-cover.jpg', label: '香格里拉' },
      { src: '/images/photography/yunnan/kunming-cover.jpg', label: '昆明' },
      { src: '/images/photography/yunnan/deqin-cover.jpg', label: '德钦' },
    ],
  },
];

const visited = photoCards.flatMap((card) =>
  card.cities.map((city) => ({
    ...city,
    cardId: card.id,
  }))
);
const firstCard = photoCards[0];
const firstPhoto = firstCard.photos[0];
---

<section class="photo-map-section" aria-label="摄影地图">
  <div class="map-shell" data-cities={JSON.stringify(visited)}>
    <div class="map-main">
      <div id="china-map"></div>
      <svg class="map-connector" aria-hidden="true"></svg>
    </div>

    <aside class="photo-panel" aria-label="城市代表照片">
      {photoCards.map((card) => (
        <button
          class={`photo-frame photo-frame--${card.placement} ${card.photos.length > 1 ? 'photo-frame--stacked' : ''}`}
          type="button"
          aria-label={`查看 ${card.title} 原图`}
          data-card-id={card.id}
          data-city={card.title}
          data-photo={card.photos[0].src}
          data-caption={card.caption}
        >
          <span class="photo-stack" aria-hidden={card.photos.length === 1 ? undefined : 'true'}>
            {card.photos.slice(0, 3).map((photo, index) => (
              <span class={`photo-print photo-print--${index + 1}`}>
                <img class="photo-img" src={photo.src} alt={`${photo.label} 代表照片`} loading="lazy" />
                <span class="photo-missing" hidden>
                  <span>PHOTO</span>
                  <small>{photo.label}</small>
                </span>
              </span>
            ))}
          </span>
          {card.photos.length > 3 && (
            <span class="photo-count" aria-hidden="true">+{card.photos.length - 3}</span>
          )}
          <span class="photo-note">
            <strong>{card.title}</strong>
            <span>
              {card.photos.length > 1 ? `${card.photos.map((photo) => photo.label).join(' / ')}` : card.caption}
            </span>
          </span>
          <span class="photo-anchor photo-anchor--top" aria-hidden="true"></span>
          <span class="photo-anchor photo-anchor--right" aria-hidden="true"></span>
          <span class="photo-anchor photo-anchor--bottom" aria-hidden="true"></span>
          <span class="photo-anchor photo-anchor--left" aria-hidden="true"></span>
        </button>
      ))}
    </aside>
  </div>

  <div class="photo-lightbox" aria-hidden="true">
    <button class="photo-lightbox-close" type="button" aria-label="关闭原图">×</button>
    <img src={firstPhoto.src} alt={`${firstCard.title} 原图`} />
    <p>{firstCard.title} · {firstCard.caption}</p>
  </div>
</section>

<script is:inline data-astro-rerun>
  // @ts-nocheck
  (function () {
    const ECHARTS_CDN = 'https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js';
    const GEO_CDN = 'https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json';

    function loadScript(src) {
      if (window.echarts) return Promise.resolve();
      if (window.__photoMapEchartsPromise) return window.__photoMapEchartsPromise;

      window.__photoMapEchartsPromise = new Promise((resolve, reject) => {
        const existing = document.querySelector(`script[src="${src}"]`);
        if (existing) {
          existing.remove();
        }

        const script = document.createElement('script');
        script.src = src;
        script.onload = () => resolve();
        script.onerror = () => {
          window.__photoMapEchartsPromise = null;
          reject(new Error('Failed to load ECharts'));
        };
        document.head.appendChild(script);
      });

      return window.__photoMapEchartsPromise;
    }

    function setupLightbox(section) {
      const frames = section.querySelectorAll('.photo-frame');
      const lightbox = section.querySelector('.photo-lightbox');
      const lightboxClose = section.querySelector('.photo-lightbox-close');
      const lightboxImg = lightbox?.querySelector('img');
      const lightboxCaption = lightbox?.querySelector('p');

      section.querySelectorAll('.photo-img').forEach((photo) => {
        const fallback = photo.parentElement?.querySelector('.photo-missing');
        if (!fallback || photo.dataset.fallbackReady) return;
        photo.dataset.fallbackReady = 'true';
        photo.addEventListener('error', () => {
          photo.hidden = true;
          fallback.hidden = false;
        });
      });

      if (!frames.length || !lightbox || !lightboxClose || !lightboxImg || !lightboxCaption) return;

      const close = () => {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
      };

      frames.forEach((frame) => {
        if (frame.dataset.lightboxReady) return;
        frame.dataset.lightboxReady = 'true';
        frame.addEventListener('click', () => {
          if (frame.dataset.wasDragged === 'true') {
            frame.dataset.wasDragged = 'false';
            return;
          }

          const name = frame.dataset.city || '';
          const caption = frame.dataset.caption || '';
          lightboxImg.src = frame.dataset.photo || '';
          lightboxImg.alt = `${name} 原图`;
          lightboxCaption.textContent = `${name} · ${caption}`;
          lightbox.classList.add('is-open');
          lightbox.setAttribute('aria-hidden', 'false');
        });
      });

      if (!lightbox.dataset.closeReady) {
        lightbox.dataset.closeReady = 'true';
        lightboxClose.addEventListener('click', close);
        lightbox.addEventListener('click', (event) => {
          if (event.target === lightbox) close();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') close();
        });
      }
    }

    function setupDraggableFrames(section, onMove) {
      if (section.dataset.dragReady === 'true') return;
      section.dataset.dragReady = 'true';

      const panel = section.querySelector('.photo-panel');
      const frames = section.querySelectorAll('.photo-frame');
      if (!panel || !frames.length) return;

      frames.forEach((frame) => {
        frame.addEventListener('pointerdown', (event) => {
          if (window.matchMedia('(max-width: 860px)').matches) return;
          if (event.button !== 0) return;

          const panelRect = panel.getBoundingClientRect();
          const frameRect = frame.getBoundingClientRect();
          const startX = event.clientX;
          const startY = event.clientY;
          const startLeft = frameRect.left - panelRect.left;
          const startTop = frameRect.top - panelRect.top;
          let moved = false;

          frame.setPointerCapture(event.pointerId);
          frame.classList.add('is-dragging');

          const move = (moveEvent) => {
            const dx = moveEvent.clientX - startX;
            const dy = moveEvent.clientY - startY;
            if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;

            frame.style.left = `${Math.round(startLeft + dx)}px`;
            frame.style.top = `${Math.round(startTop + dy)}px`;
            frame.style.right = 'auto';
            frame.style.bottom = 'auto';
            frame.dataset.dragged = 'true';
            window.requestAnimationFrame(onMove);
          };

          const up = (upEvent) => {
            frame.releasePointerCapture(upEvent.pointerId);
            frame.classList.remove('is-dragging');
            frame.removeEventListener('pointermove', move);
            frame.removeEventListener('pointerup', up);
            frame.removeEventListener('pointercancel', up);

            if (moved) {
              frame.dataset.wasDragged = 'true';
              window.setTimeout(() => {
                frame.dataset.wasDragged = 'false';
              }, 250);
            }
            window.requestAnimationFrame(() => {
              window.requestAnimationFrame(onMove);
            });
          };

          frame.addEventListener('pointermove', move);
          frame.addEventListener('pointerup', up);
          frame.addEventListener('pointercancel', up);
        });
      });
    }

    function drawConnectors(section, chart, cities) {
      const mapNode = section.querySelector('#china-map');
      const svg = section.querySelector('.map-connector');

      if (!mapNode || !svg) return;

      const mapRect = mapNode.getBoundingClientRect();
      if (mapRect.width === 0 || mapRect.height === 0) return;

      svg.setAttribute('viewBox', `0 0 ${mapRect.width} ${mapRect.height}`);
      const fragment = document.createDocumentFragment();

      const groupedCities = cities.reduce((groups, city) => {
        const key = city.cardId || city.name;
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key).push(city);
        return groups;
      }, new Map());

      groupedCities.forEach((group, cardId) => {
        const frame = section.querySelector(`.photo-frame[data-card-id="${cardId}"]`);
        const pixels = group
          .map((city) => chart.convertToPixel({ geoIndex: 0 }, city.coords))
          .filter(Boolean);
        if (!frame || !pixels.length) return;

        const pixel = pixels.reduce(
          (acc, item) => [acc[0] + item[0] / pixels.length, acc[1] + item[1] / pixels.length],
          [0, 0]
        );
        const startX = pixel[0];
        const startY = pixel[1];
        const anchors = Array.from(frame.querySelectorAll('.photo-anchor'))
          .map((anchor) => {
            const rect = anchor.getBoundingClientRect();
            const x = rect.left - mapRect.left + rect.width / 2;
            const y = rect.top - mapRect.top + rect.height / 2;
            return {
              x,
              y,
              distance: Math.hypot(x - startX, y - startY),
            };
          })
          .sort((a, b) => a.distance - b.distance);
        const endpoint = anchors[0];
        if (!endpoint) return;

        const endX = endpoint.x;
        const endY = endpoint.y;

        const dx = endX - startX;
        const curveX = Math.sign(dx || 1) * Math.max(80, Math.abs(dx));
        const c1X = startX + curveX * 0.35;
        const c1Y = startY - 26;
        const c2X = endX - curveX * 0.2;
        const c2Y = endY + 10;

        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('class', 'map-connector-path');
        path.setAttribute('d', `M ${startX} ${startY} C ${c1X} ${c1Y}, ${c2X} ${c2Y}, ${endX} ${endY}`);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', '#222222');
        path.setAttribute('stroke-width', '1.15');
        path.setAttribute('stroke-linecap', 'round');
        path.setAttribute('vector-effect', 'non-scaling-stroke');

        const startDot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        startDot.setAttribute('class', 'map-connector-start');
        startDot.setAttribute('r', group.length > 1 ? '4.6' : '3.3');
        startDot.setAttribute('cx', String(startX));
        startDot.setAttribute('cy', String(startY));
        startDot.setAttribute('fill', '#111111');
        startDot.setAttribute('stroke', '#ffffff');
        startDot.setAttribute('stroke-width', '2');
        startDot.setAttribute('vector-effect', 'non-scaling-stroke');

        const endDot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        endDot.setAttribute('class', 'map-connector-end');
        endDot.setAttribute('r', '3');
        endDot.setAttribute('cx', String(endX));
        endDot.setAttribute('cy', String(endY));
        endDot.setAttribute('fill', '#111111');
        endDot.setAttribute('stroke', '#ffffff');
        endDot.setAttribute('stroke-width', '2');
        endDot.setAttribute('vector-effect', 'non-scaling-stroke');

        fragment.append(path, startDot, endDot);
      });

      if (fragment.childNodes.length) {
        svg.replaceChildren(fragment);
      }
    }

    function positionPhotoFrames(section) {
      if (window.matchMedia('(max-width: 860px)').matches) return;

      const shell = section.querySelector('.map-shell');
      const panel = section.querySelector('.photo-panel');
      const mapNode = section.querySelector('#china-map');
      const frames = section.querySelectorAll('.photo-frame');
      if (!shell || !panel || !mapNode || !frames.length) return;

      const panelRect = panel.getBoundingClientRect();
      const mapRect = mapNode.getBoundingClientRect();
      const gap = 22;
      const mapLeft = mapRect.left - panelRect.left;
      const mapTop = mapRect.top - panelRect.top;
      const mapRight = mapRect.right - panelRect.left;
      const mapBottom = mapRect.bottom - panelRect.top;
      const mapWidth = mapRect.width;
      const mapHeight = mapRect.height;

      frames.forEach((frame) => {
        if (frame.dataset.dragged === 'true') return;

        const rect = frame.getBoundingClientRect();
        const placement = Array.from(frame.classList)
          .find((name) => name.startsWith('photo-frame--') && name !== 'photo-frame--stacked')
          ?.replace('photo-frame--', '');

        let left = mapLeft + mapWidth * 0.5 - rect.width * 0.5;
        let top = mapTop + mapHeight * 0.5 - rect.height * 0.5;

        if (placement === 'left-top') {
          left = mapLeft - rect.width - gap;
          top = mapTop + mapHeight * 0.04;
        } else if (placement === 'left-mid') {
          left = mapLeft - rect.width - gap;
          top = mapTop + mapHeight * 0.56 - rect.height * 0.5;
        } else if (placement === 'right-top') {
          left = mapRight + gap;
          top = mapTop + mapHeight * 0.04;
        } else if (placement === 'right-mid') {
          left = mapRight + gap;
          top = mapTop + mapHeight * 0.56 - rect.height * 0.5;
        } else if (placement === 'left-bottom') {
          left = mapLeft + mapWidth * 0.46;
          top = mapBottom + gap;
        } else if (placement === 'bottom-left') {
          left = mapLeft + mapWidth * 0.2;
          top = mapBottom + gap;
        } else if (placement === 'bottom-mid') {
          left = mapLeft + mapWidth * 0.72;
          top = mapBottom + gap;
        }

        frame.style.left = `${Math.round(left)}px`;
        frame.style.top = `${Math.round(top)}px`;
        frame.style.right = 'auto';
        frame.style.bottom = 'auto';
      });
    }

    function renderMap(section, echarts, geo, cities) {
      const mapNode = section.querySelector('#china-map');
      if (!mapNode || !cities.length) return;

      const existing = echarts.getInstanceByDom(mapNode);
      if (existing) existing.dispose();

      echarts.registerMap('china', geo);
      const chart = echarts.init(mapNode);
      chart.setOption({
        backgroundColor: 'transparent',
        animationDuration: 700,
        geo: {
          map: 'china',
          roam: false,
          zoom: 1.32,
          center: [105, 34],
          aspectScale: 0.85,
          itemStyle: {
            areaColor: '#eeeeee',
            borderColor: '#c8c8c8',
            borderWidth: 0.6,
          },
          emphasis: {
            itemStyle: {
              areaColor: '#e4e4e4',
            },
            label: {
              show: false,
            },
          },
        },
        series: [
          {
            type: 'effectScatter',
            coordinateSystem: 'geo',
            data: cities.map((city) => ({
              name: city.name,
              value: city.coords,
              label: {
                position: city.labelPosition || 'right',
                distance: city.labelDistance || 8,
                fontSize: city.compactLabel ? 13 : 18,
              },
            })),
            symbol: 'circle',
            symbolSize: 8,
            rippleEffect: {
              brushType: 'stroke',
              scale: 3.5,
              period: 3.2,
              color: '#111111',
            },
            itemStyle: {
              color: '#111111',
              borderColor: '#ffffff',
              borderWidth: 2,
            },
            label: {
              show: true,
              position: 'right',
              distance: 8,
              color: '#30343a',
              fontSize: 18,
              fontWeight: 900,
              fontFamily: 'Georgia, "Times New Roman", "Noto Serif SC", serif',
              formatter: '{b}',
            },
            labelLayout: {
              hideOverlap: true,
            },
          },
        ],
      });

      const sync = () => {
        chart.resize();
        window.requestAnimationFrame(() => {
          positionPhotoFrames(section);
          drawConnectors(section, chart, cities);
        });
      };

      const redrawConnectors = () => {
        chart.resize();
        window.requestAnimationFrame(() => {
          drawConnectors(section, chart, cities);
        });
      };

      setupDraggableFrames(section, redrawConnectors);

      window.requestAnimationFrame(sync);
      window.setTimeout(sync, 120);
      window.setTimeout(sync, 420);
      window.setTimeout(sync, 900);
      chart.off('finished');
      chart.on('finished', sync);

      if (section.__photoMapResize) {
        window.removeEventListener('resize', section.__photoMapResize);
      }
      section.__photoMapResize = sync;
      window.addEventListener('resize', sync);
    }

    async function initPhotographyMap() {
      const section = document.querySelector('.photo-map-section');
      if (!section) return;

      const shell = section.querySelector('.map-shell');
      const mapNode = section.querySelector('#china-map');
      if (!shell || !mapNode) return;

      setupLightbox(section);

      const cities = JSON.parse(shell.getAttribute('data-cities') || '[]');
      if (!cities.length) return;

      try {
        if (!window.echarts) await loadScript(ECHARTS_CDN);
        if (!window.echarts) throw new Error('ECharts unavailable');
        const res = await fetch(GEO_CDN);
        const geo = await res.json();
        renderMap(section, window.echarts, geo, cities);
      } catch {
        mapNode.classList.add('map-failed');
        mapNode.textContent = '地图加载失败';
      }
    }

    document.addEventListener('astro:page-load', initPhotographyMap);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPhotographyMap, { once: true });
    } else {
      initPhotographyMap();
    }
  })();
</script>

<style>
  .photo-map-section {
    width: min(100%, 1500px);
    margin: 0 auto;
    padding: 1.5rem clamp(1rem, 2.2vw, 2rem) 3.5rem;
  }

  .map-shell {
    position: relative;
    min-height: 820px;
  }

  .map-main {
    position: relative;
    min-width: 0;
    width: min(66vw, 980px);
    height: min(62vh, 610px);
    min-height: 500px;
    margin: 5rem auto 9rem;
  }

  #china-map {
    width: 100%;
    height: 100%;
  }

  .map-failed {
    display: grid;
    place-items: center;
    color: var(--muted);
    border: 1px solid var(--soft-line);
  }

  .map-connector {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 3;
  }

  .map-connector-path {
    fill: none;
    stroke: #222222;
    stroke-width: 1.15;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .map-connector-start,
  .map-connector-end {
    fill: #111111;
    stroke: #ffffff;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .photo-panel {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }

  .photo-frame {
    position: absolute;
    display: block;
    width: clamp(126px, 10.5vw, 172px);
    transform: rotate(1.2deg);
    background: #ffffff;
    border: 1px solid #202020;
    padding: 0.55rem 0.55rem 0.45rem;
    box-shadow: 0.4rem 0.4rem 0 #d8d8d8;
    cursor: grab;
    text-align: left;
    transition: transform 160ms ease, box-shadow 160ms ease;
    pointer-events: auto;
    touch-action: none;
    user-select: none;
  }

  .photo-frame:hover {
    transform: rotate(0.5deg) translateY(-2px);
    box-shadow: 0.5rem 0.5rem 0 #cfcfcf;
  }

  .photo-frame.is-dragging {
    z-index: 20;
    cursor: grabbing;
    transform: rotate(0deg) scale(1.02);
    box-shadow: 0.65rem 0.65rem 0 #c7c7c7;
    transition: box-shadow 120ms ease;
  }

  .photo-anchor {
    position: absolute;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
  }

  .photo-anchor--top {
    top: -0.325rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .photo-anchor--right {
    top: 50%;
    right: -0.325rem;
    transform: translateY(-50%);
  }

  .photo-anchor--bottom {
    bottom: -0.325rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .photo-anchor--left {
    top: 50%;
    left: -0.325rem;
    transform: translateY(-50%);
  }

  .photo-frame--left-top {
    top: 0;
    left: 0;
    transform: rotate(-2.2deg);
  }

  .photo-frame--left-mid {
    top: 34%;
    left: 0;
    transform: rotate(1.6deg);
  }

  .photo-frame--left-bottom {
    bottom: -3rem;
    left: 46%;
    transform: rotate(-1.1deg);
  }

  .photo-frame--bottom-left {
    bottom: -3rem;
    left: 20%;
    transform: rotate(2.1deg);
  }

  .photo-frame--right-top {
    top: 0;
    right: 0;
    transform: rotate(1.3deg);
  }

  .photo-frame--right-mid {
    top: 32%;
    right: 0;
