---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const headings = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  headings.length > 0 && (
    <aside class="article-toc" aria-label="文章目录">
      <section class="sidebar-section">
        <h2 class="sidebar-title">Toc</h2>
        <ol class="sidebar-list">
          {headings.map((heading) => (
            <li class={heading.depth === 3 ? 'depth-3' : ''}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </section>
    </aside>
  )
}
