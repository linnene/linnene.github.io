---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArchiveMonths, publishedPosts, sortByDate } from '../../lib/blog';

const posts = sortByDate(publishedPosts(await getCollection('blog')));
const archiveMonths = getArchiveMonths(posts);
---

<BaseLayout
  title="Blog"
  description="文章归档。"
  headerTitle="Blog"
  headerSubtitle="所有文章按月份归档，主题先保持开放。"
>
  <div class="content-grid">
    <section class="main-column">
      {archiveMonths.length > 0 ? (
        archiveMonths.map(([id, archive]) => (
          <section id={id} class="archive-month">
            <h1 class="page-title">{archive.label}</h1>
            <div class="post-list">
              {posts
                .filter((entry) => `${entry.data.date.getFullYear()}-${String(entry.data.date.getMonth() + 1).padStart(2, '0')}` === id)
                .map((entry) => <ArticleCard entry={entry} />)}
            </div>
          </section>
        ))
      ) : (
        <>
          <h1 class="page-title">Blog</h1>
          <p class="empty-state">还没有文章。添加第一篇 MDX 后，这里会自动按月份归档。</p>
        </>
      )}
    </section>

    <BlogSidebar />
  </div>
</BaseLayout>
