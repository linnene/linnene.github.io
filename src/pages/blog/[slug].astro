---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { sortByDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = sortByDate(
    (await getCollection('blog')).filter((entry) => !entry.data.draft && entry.filePath && existsSync(entry.filePath))
  );
  return posts.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: posts[index + 1],
      next: posts[index - 1],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</ArticleLayout>
